# ---------------------------------------------------------------------------
# UniversalAutoApplier - local-first configuration
#
# Copy this file to `.env` and edit values for your machine.
# `.env` is gitignored. Never commit real credentials or absolute paths
# that point at private data.
#
# All settings can also be provided as real environment variables, which take
# precedence over this file.
# ---------------------------------------------------------------------------

# Bind the local API/dashboard to localhost only. Do NOT change to 0.0.0.0
# unless you have added authentication first. See DEPLOYMENT_AND_REPO_STRATEGY.md.
UAA_HOST=127.0.0.1
UAA_PORT=8000

# Absolute path to a local data directory owned by UniversalAutoApplier.
# Queue, history database, logs, screenshots, traces, and artifacts live here.
UAA_DATA_DIR=./.uaa_data

# Absolute path to the JobHunter export file (application_queue.jsonl).
# Optional: if unset, the JobHunter queue is reported as `not_configured` in
# system health, but the dashboard still runs. UAA_JOBHUNTER_QUEUE is the
# legacy name for this same value and still works as a fallback.
UAA_QUEUE_PATH=

# Import the configured queue once during startup. False by default: startup
# never imports anything unless this is explicitly enabled. When true, a
# missing or unconfigured path is recorded as a durable failed/skipped import
# run and surfaced in health/status/dashboard without crashing the server.
UAA_IMPORT_QUEUE_ON_STARTUP=false

# Absolute path to the SiemensAutoApplier repository. Optional. If unset, the
# Siemens adapter is reported as `not_configured` in system health.
UAA_SIEMENS_REPO=

# Browser headless flag. Headed mode is the local default; headless is the test
# default. Set to `true` only when you do not need to observe the browser.
UAA_BROWSER_HEADLESS=false

# Optional persistent Playwright profile. UAA stores login cookies here so
# later live dry-runs can reuse an authenticated session. Keep this local and
# gitignored. If unset, the CLI uses UAA_DATA_DIR/browser-profile.
UAA_BROWSER_PROFILE_DIR=

# Optional installed browser channel (for example: chrome or msedge). Leave
# empty to use Playwright's bundled Chromium.
UAA_BROWSER_CHANNEL=
UAA_BROWSER_TIMEOUT_MS=30000
UAA_BROWSER_MAX_STEPS=20

# Submission mode. Safe defaults are `dry_run` and `review`. The mode
# `trusted_auto_submit` is dangerous and must never be the default for generic
# adapters. See IMPLEMENTATION_RULES.md -> Safety Rules for Submit.
UAA_SUBMIT_MODE=review

# Controlled final submission gate. When false (the default), the live
# browser runner NEVER clicks the final submit control, even if the user
# has approved a snapshot. This is the hard kill switch.
# When true, the SubmissionCoordinator may click submit ONLY after every
# other gate (approval, snapshot match, no pending interventions, etc.)
# also passes. See docs/testing/CONTROLLED_REAL_SUBMISSION_TEST_PLAN.md.
UAA_ENABLE_REAL_SUBMISSION=false

# ---------------------------------------------------------------------------
# LLM question resolution (Gemma)
#
# When the live browser executor encounters a form question that
# deterministic mapping cannot answer, a grounded LLM service (backed by
# Google/Gemma) may propose an answer using candidate evidence.
#
# The service may compose answers and infer from documented evidence, but
# it must never invent personal facts. Final submission remains blocked.
# High-risk categories (salary, legal, demographic, consent) always
# require human confirmation even if the LLM proposes an answer.
# ---------------------------------------------------------------------------

# Provider: "gemma" (default, uses google-genai SDK) or "mock" (for tests).
UAA_LLM_PROVIDER=gemma

# Google AI API key. If unset, the LLM service is "not_configured" and
# the executor creates an intervention for unresolved questions.
# Supports multiple keys via GOOGLE_AI_API_KEY, GOOGLE_AI_API_KEY2, etc.
# (same pattern as JobHunter). Set UAA_LLM_API_KEY to the primary key.
UAA_LLM_API_KEY=

# Model identifier. MUST be set explicitly to a model you have verified
# is available with your API key. If unset, the service reports
# "model_not_configured" and the executor creates interventions.
# JobHunter uses "gemma-4-26b-a4b-it" as its primary Google model, but
# model availability changes over time — verify before setting.
UAA_LLM_MODEL=

# Comma-separated fallback models (tried in order if the primary fails).
UAA_LLM_FALLBACK_MODELS=gemma-4-31b-it

# Request timeout in milliseconds.
UAA_LLM_TIMEOUT_MS=30000

# Retry count on transient failures (quota, timeout, 500s).
UAA_LLM_RETRY_COUNT=2

# Minimum confidence for auto-fill without human confirmation.
# Below this threshold, the answer requires user confirmation.
UAA_LLM_MIN_AUTO_FILL_CONFIDENCE=0.8

# ---------------------------------------------------------------------------
# Cross-repository orchestration (WQ-6)
#
# UAA can orchestrate JobHunter export -> UAA queue import -> UAA pipeline
# in either sequential or parallel mode. JobHunter runs as an external
# subprocess (process-level boundary; UAA never imports JobHunter Python
# modules). The orchestration never performs final submission.
# ---------------------------------------------------------------------------

# Absolute path to the JobHunter repository root (the directory containing
# run_all.py). UAA launches JobHunter from this directory as a subprocess.
# Required for orchestration to start.
UAA_JOBHUNTER_REPO=

# Python executable used to run JobHunter. Defaults to sys.executable (the
# same Python running UAA). Set explicitly when JobHunter runs in its own
# virtualenv (recommended).
UAA_JOBHUNTER_PYTHON=

# Entry point script name inside the JobHunter repo. The production default
# is "run_all.py" (the full-workflow entry point: scan -> evaluate/tailor
# -> atomic queue export). For testing, this can be set to a fake producer
# script. run_all.py does NOT accept --output; it reads the queue path from
# JobHunter's config/profile.yml -> queue_export.output_path.
UAA_JOBHUNTER_ENTRY_POINT=run_all.py

# Queue output path where JobHunter writes application_queue.jsonl.
# When set, this MUST exactly match JobHunter's config/profile.yml ->
# queue_export.output_path (resolved against the JobHunter repo root).
# When unset (recommended), UAA reads the path from JobHunter's
# config/profile.yml and falls back to <jobhunter_repo>/data/application_queue.jsonl.
UAA_JOBHUNTER_QUEUE_OUTPUT=

# Default orchestration mode: "sequential" (JobHunter fully completes before
# UAA imports + pipeline) or "parallel" (UAA pipeline starts for existing
# queued jobs while JobHunter runs concurrently; a second pipeline pass
# processes newly imported jobs after JobHunter completes).
UAA_ORCHESTRATION_MODE=sequential

# Grace period (seconds) for graceful termination of the JobHunter child
# before forced termination (SIGKILL/TerminateProcess) is used.
# Range: 1-60 seconds.
UAA_ORCHESTRATION_CANCEL_GRACE_SECONDS=5

# Maximum bytes of JobHunter stdout/stderr captured into the durable
# orchestration run row. The capture is bounded to prevent unbounded memory
# growth; secrets are filtered before persistence. Range: 256-65536 bytes.
UAA_ORCHESTRATION_CAPTURE_MAX_BYTES=8192

# Timeout (seconds) for the JobHunter subprocess. If the process does not
# exit within this period, it is terminated gracefully, then force-killed
# after the grace period, and the orchestration run is marked failed.
# 0 means no timeout (wait indefinitely). Range: 0-3600 seconds.
UAA_JOBHUNTER_TIMEOUT_SECONDS=0

# Effective worker counts. Both JobHunter (run_all.py) and the UAA pipeline
# are single-worker (sequential subprocess). These are read-only configuration
# values that document the effective concurrency model. Worker counts > 1 are
# rejected until real worker pools exist. Both must be exactly 1.
UAA_JOBHUNTER_WORKERS=1
UAA_PIPELINE_WORKERS=1
